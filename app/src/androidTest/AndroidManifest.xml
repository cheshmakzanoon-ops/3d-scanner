<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Installed only in the test APK. Serves a fixed, generated synthetic fixture set. -->
        <provider
            android:name="com.realityforge.scanner.agents.a011.FixturePhotoProvider"
            android:authorities="com.realityforge.scanner.test.a011.photo-fixture"
            android:exported="true"
            android:grantUriPermissions="true" />
        <!-- One shared test-only DocumentsProvider for the Agent 088 failure matrix. -->
        <provider
            android:name="com.realityforge.scanner.qa.FaultDocumentProvider"
            android:authorities="com.realityforge.scanner.test.shared.fault-documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
        <receiver
            android:name="com.realityforge.scanner.qa.FaultDocumentProvider$ControlReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
