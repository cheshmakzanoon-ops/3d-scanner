+    /** Reject symlinks in EVERY existing ancestor; synthetic owned paths only. */
+    private fun strictPath(file: File, regular: Boolean): BasicFileAttributes {
+        val path = file.toPath().toAbsolutePath().normalize()
+        require(path == file.canonicalFile.toPath()) { "Noncanonical evidence path" }
+        var current = requireNotNull(path.root)
+        for (part in path) {
+            current = current.resolve(part)
+            val attrs = Files.readAttributes(current, BasicFileAttributes::class.java, LinkOption.NOFOLLOW_LINKS)
+            require(!attrs.isSymbolicLink)
+            require(if (current == path && regular) attrs.isRegularFile else attrs.isDirectory)
+        }
+        return Files.readAttributes(path, BasicFileAttributes::class.java, LinkOption.NOFOLLOW_LINKS)
+    }
+    private fun boundedCheckpointHash(file: File, maximum: Long): String {
+        require(strictPath(file, true).size() in 1..maximum)
+        val digest = MessageDigest.getInstance("SHA-256")
+        var bytes = 0L
+        Files.newInputStream(file.toPath(), StandardOpenOption.READ, LinkOption.NOFOLLOW_LINKS).use { input ->
+            val buffer = ByteArray(8192)
+            while (true) {
+                val count = input.read(buffer)
+                if (count < 0) break
+                bytes += count
+                require(bytes <= maximum)
+                digest.update(buffer, 0, count)
+            }
+        }
+        require(bytes > 0)
+        return digest.digest().joinToString("") { "%02x".format(it) }
+    }
+    private fun captureOwnedCheckpoint(root: File, source: File, target: File): JSONObject {
+        val maximum = 12L * 1024 * 1024
+        strictPath(root, false)
+        val sourcePath = source.toPath().toAbsolutePath().normalize()
+        require(sourcePath.startsWith(root.canonicalFile.toPath()) && sourcePath != root.canonicalFile.toPath())
+        val before = strictPath(source, true)
+        require(before.size() in 1..maximum)
+        strictPath(target.parentFile, false)
+        require(!Files.exists(target.toPath(), LinkOption.NOFOLLOW_LINKS))
+        val beforeHash = boundedCheckpointHash(source, maximum)
+        val digest = MessageDigest.getInstance("SHA-256")
+        var copied = 0L
+        Files.newInputStream(sourcePath, StandardOpenOption.READ, LinkOption.NOFOLLOW_LINKS).use { input ->
+            Files.newOutputStream(target.toPath(), StandardOpenOption.CREATE_NEW, StandardOpenOption.WRITE,
+                LinkOption.NOFOLLOW_LINKS).use { output ->
+                val buffer = ByteArray(8192)
+                while (true) {
+                    val count = input.read(buffer)
+                    if (count < 0) break
+                    copied += count
+                    require(copied <= maximum && copied <= before.size())
+                    digest.update(buffer, 0, count)
+                    output.write(buffer, 0, count)
+                }
+            }
+        }
+        val after = strictPath(source, true)
+        val destination = strictPath(target, true)
+        require(before.fileKey() != null && before.fileKey() == after.fileKey())
+        require(before.size() == after.size() && before.lastModifiedTime() == after.lastModifiedTime())
+        require(copied == before.size() && destination.size() == copied)
+        val copiedHash = digest.digest().joinToString("") { "%02x".format(it) }
+        assertEquals(beforeHash, copiedHash)
+        assertEquals(beforeHash, boundedCheckpointHash(source, maximum))
+        assertEquals(beforeHash, boundedCheckpointHash(target, maximum))
+        strictPath(source, true).also { final ->
+            require(final.fileKey() == before.fileKey() && final.size() == before.size() && final.lastModifiedTime() == before.lastModifiedTime())
+        }
+        strictPath(target, true).also { final ->
+            require(final.fileKey() == destination.fileKey() && final.size() == destination.size() && final.lastModifiedTime() == destination.lastModifiedTime())
+        }
+        return JSONObject().put("sha256", copiedHash).put("bytes", copied)
+    }
