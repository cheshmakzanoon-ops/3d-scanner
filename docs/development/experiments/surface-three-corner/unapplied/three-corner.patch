+// Exact surface-admission fixtures, not fabricated output of the photographic stereo test.
+// Default production limits remain unchanged (maxVertices/maxTriangles >=10).
+struct CornerFixture {
+    std::vector<rf::DenseView> views;
+    rf::DenseResult dense;
+    CornerFixture(unsigned mask, std::array<float,4> depths={5,5,5,5}, double fx=100,double fy=100) {
+        views=fixture(2);dense.maps.resize(views.size());
+        for(std::size_t cam=0;cam<views.size();++cam){
+            views[cam].fx=fx;views[cam].fy=fy;
+            auto& map=dense.maps[cam];map.width=104;map.height=76;
+            map.depth.assign(104*76,0);map.confidence.assign(104*76,0);
+        }
+        const auto& v=views[0];
+        for(int corner=0;corner<4;++corner)if(mask&(1u<<corner)){
+            const int x=12+(corner%2)*3,y=12+(corner/2)*3;const auto d=depths[corner];
+            dense.maps[0].depth[y*104+x]=d;dense.maps[0].confidence[y*104+x]=.95f;
+            dense.verifiedSamples.push_back({{(x-v.cx)*d/v.fx,(y-v.cy)*d/v.fy,d},
+                {150,140,120},.95f,2,0,static_cast<std::uint16_t>(x),static_cast<std::uint16_t>(y)});
+        }
+    }
+};
+std::vector<std::array<int,3>> cornerFaces(const rf::SurfaceMesh& mesh,const rf::DenseView& view){
+    std::vector<std::array<int,3>> result;
+    for(const auto& face:mesh.triangles){
+        std::array<int,3> corners{};int k=0;
+        for(auto id:{face.a,face.b,face.c}){
+            require(id<mesh.vertices.size(),"Triangle exceeds output vertex bound");
+            const auto p=mesh.vertices[id].xyz;
+            const int x=static_cast<int>(std::lround(view.fx*p.x/p.z+view.cx));
+            const int y=static_cast<int>(std::lround(view.fy*p.y/p.z+view.cy));
+            require((x==12||x==15)&&(y==12||y==15),"Triangle escaped its source cell");
+            corners[k++]=(x-12)/3+2*((y-12)/3);
+        }
+        std::sort(corners.begin(),corners.end());result.push_back(corners);
+    }
+    std::sort(result.begin(),result.end());
+    require(std::adjacent_find(result.begin(),result.end())==result.end(),"Duplicate supported face emitted");
+    return result;
+}
+
 }
