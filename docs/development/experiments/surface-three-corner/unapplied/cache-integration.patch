+package com.realityforge.scanner.engine.pipeline
+
+import com.realityforge.scanner.data.ProjectInputPhoto
+import com.realityforge.scanner.data.ProjectInputSnapshot
+import com.realityforge.scanner.engine.artifacts.ArtifactBinding
+import com.realityforge.scanner.engine.artifacts.PipelineStage as ArtifactStage
+import com.realityforge.scanner.processing.resources.ResourceWorkloadSelection
+import org.junit.Assert.*
+import org.junit.Test
+
+class SurfaceAlgorithmIdentityTest {
+    @Test fun productionV7ChangesOnlySurfaceAndItsDownstreamIdentities() {
+        val input = ProjectInputSnapshot("surface-project", 4, (0..2).map { i ->
+            ProjectInputPhoto("photo-$i", sha256Utf8("jpeg-$i"), 1024, 800, 600, 35.0, 0)
+        })
+        for (resources in ResourceWorkloadSelection.entries) {
+            val current = ProductionPipelineSnapshot.create(input, sha256Utf8("calibration"), 35.0, resources)
+            assertEquals("rf-observed-open-mesh-v7-supported-three-corner-fusion", current.settings.surface)
+            assertEquals(DenseExecutionPolicy.SURFACE_ENGINE, current.settings.surface)
+            val legacy = current.copy(settings = current.settings.copy(surface = "observed-open-mesh-v1|quality-gated"))
+            val binding = ArtifactBinding(input.projectId, input.revision, "surface-job", 1)
+            val oldPlan = PipelineArtifactSession.identityPlan(legacy, binding)
+            val newPlan = PipelineArtifactSession.identityPlan(current, binding)
+            for (stage in listOf(ArtifactStage.FEATURES, ArtifactStage.MATCHES, ArtifactStage.ALIGNMENT, ArtifactStage.DENSE_DEPTH)) {
+                assertEquals("Upstream stage invalidated: $stage", oldPlan[stage].identityHash, newPlan[stage].identityHash)
+            }
+            for (stage in listOf(ArtifactStage.SURFACE, ArtifactStage.TEXTURE, ArtifactStage.LOD, ArtifactStage.EXPORT)) {
+                assertNotEquals("Old geometry can still be reused: $stage", oldPlan[stage].identityHash, newPlan[stage].identityHash)
+            }
+            assertEquals(legacy.engineVersion, current.engineVersion)
+            assertEquals(legacy.photos, current.photos)
+        }
+    }
+}
