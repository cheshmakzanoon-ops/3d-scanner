+    private const val ENGINE_SHA = "1b03206aa399fbeeabb333a5292a639322676f659d939009f53ee90f7bd8204d"
+    private const val SHIM = "/tmp/relief-fusion-trace-stageb-shim-evidence/librealityforge_jni.so"
+    private const val SHIM_SHA = "4bb81674e351d9338c4337630c19fddad9c6b5cfee86735aad493896acdb6747"
+    private const val MAX_LIBRARY = 128L * 1024 * 1024
+    private const val MAX_MAPS = 8 * 1024 * 1024
+    private const val MAX_OUTPUT = 256 * 1024
+    private val NOFOLLOW = LinkOption.NOFOLLOW_LINKS
