+    private data class Stamp(
+        val dev: Long, val ino: Long, val links: Long, val uid: Long,
+        val size: Long, val modified: String, val changed: String, val key: String
+    )
+    private data class Library(val path: Path, val sha256: String, val stamp: Stamp)
+    private data class Segment(
+        val start: String, val end: String, val permissions: String, val offset: String,
+        val major: Long, val minor: Long, val inode: Long, val path: String
+    ) {
+        fun json() = JSONObject().put("start", start).put("end", end)
+            .put("permissions", permissions).put("offset", offset)
+            .put("deviceMajor", major).put("deviceMinor", minor).put("inode", inode).put("path", path)
+    }
+    private data class Maps(val sha256: String, val segments: List<Segment>)
+
+    private fun canonical(file: File): Path {
+        val path = file.toPath()
+        require(path.isAbsolute && path.normalize() == path && path.fileName != null) { "Absolute canonical path required" }
+        require(file.path == path.toString() && file.canonicalFile.toPath() == path) { "Path aliases are forbidden" }
+        return path
+    }
+    private fun parent(path: Path): SecureDirectoryStream<Path> {
+        require(path.isAbsolute && path.normalize() == path) { "Canonical path required" }
+        var current = Files.newDirectoryStream(path.root).let {
+            if (it !is SecureDirectoryStream<*>) { it.close(); error("SecureDirectoryStream unavailable") }
+            @Suppress("UNCHECKED_CAST")
+            (it as SecureDirectoryStream<Path>)
+        }
+        try {
+            for (part in path.parent) {
+                val next = current.newDirectoryStream(part, NOFOLLOW)
+                current.close()
+                current = next
+            }
+            return current
+        } catch (failure: Throwable) { current.close(); throw failure }
+    }
+    private fun effectiveUid(): Long {
+        // proc/self deliberately denotes this JVM, not an externally supplied filesystem path.
+        val line = File("/proc/self/status").useLines { rows -> rows.first { it.startsWith("Uid:") } }
+        val values = line.trim().split(Regex("\\s+"))
+        require(values.size == 5) { "Unexpected proc uid fields" }
+        return values[2].toLong()
+    }
+    private fun currentJvmPid(): Long {
+        // Android API compilation omits ProcessHandle; this kernel file is the actual host JVM.
+        val raw = File("/proc/self/status").inputStream().use { input ->
+            val out = java.io.ByteArrayOutputStream()
+            val buffer = ByteArray(4096)
+            while (true) {
+                val n = input.read(buffer)
+                if (n < 0) break
+                require(n > 0 && out.size() + n <= 64 * 1024) { "proc status byte bound" }
+                out.write(buffer, 0, n)
+            }
+            out.toByteArray()
+        }
+        val lines = String(raw, Charsets.UTF_8).lineSequence().filter { it.startsWith("Pid:") }.toList()
+        require(lines.size == 1) { "Expected one current-process Pid field" }
+        val fields = lines.single().trim().split(Regex("\\s+"))
+        require(fields.size == 2 && fields[1].matches(Regex("[0-9]+"))) { "Invalid proc Pid field" }
+        val pid = fields[1].toLong()
+        require(pid in 1..Int.MAX_VALUE.toLong()) { "Current-process Pid out of range" }
+        return pid
+    }
+    private fun stamp(path: Path, directory: SecureDirectoryStream<Path>, uid: Long): Stamp {
+        val anchored = requireNotNull(directory.getFileAttributeView(path.fileName, PosixFileAttributeView::class.java, NOFOLLOW)).readAttributes()
+        require(anchored.isRegularFile && !anchored.isSymbolicLink) { "Expected regular NOFOLLOW file" }
+        val attributes = Files.readAttributes(path, "unix:dev,ino,nlink,uid,size,lastModifiedTime,ctime,fileKey,isRegularFile", NOFOLLOW)
+        require(attributes["isRegularFile"] == true && attributes["fileKey"].toString() == anchored.fileKey().toString()) { "Anchored/path file identity differs" }
+        fun number(key: String) = (attributes.getValue(key) as Number).toLong()
+        val value = Stamp(number("dev"), number("ino"), number("nlink"), number("uid"), number("size"),
+            attributes.getValue("lastModifiedTime").toString(), attributes.getValue("ctime").toString(), attributes.getValue("fileKey").toString())
+        require(value.uid == uid && value.links == 1L && value.size in 1..MAX_LIBRARY && anchored.size() == value.size) { "File owner/link/size guard" }
+        require(canonical(path.toFile()) == path) { "File path changed" }
+        return value
+    }
+    private fun hash(channel: SeekableByteChannel, expectedBytes: Long): String {
+        val digest = MessageDigest.getInstance("SHA-256")
+        val buffer = ByteBuffer.allocate(64 * 1024)
+        var total = 0L
+        while (true) {
+            buffer.clear()
+            val n = channel.read(buffer)
+            if (n < 0) break
+            require(n > 0) { "Unexpected empty library read" }
+            total += n
+            require(total <= expectedBytes && total <= MAX_LIBRARY) { "Library changed while reading" }
+            digest.update(buffer.array(), 0, n)
+        }
+        require(total == expectedBytes) { "Library truncated" }
+        return hex(digest.digest())
+    }
+    private fun verify(file: File, expectedPath: String, expectedHash: String, uid: Long): Library {
+        val path = canonical(file)
+        require(path.toString() == expectedPath) { "Unexpected native library path" }
+        return parent(path).use { dir ->
+            val before = stamp(path, dir, uid)
+            val options: Set<OpenOption> = setOf(StandardOpenOption.READ, NOFOLLOW)
+            val digest = dir.newByteChannel(path.fileName, options).use { hash(it, before.size) }
+            val after = stamp(path, dir, uid)
+            require(before == after && digest == expectedHash) { "Native library changed or SHA mismatch" }
+            Library(path, digest, after)
+        }
+    }
+    private fun major(dev: Long): Long = ((dev ushr 8) and 0xfffL) or ((dev ushr 32) and 0xfffff000L)
+    private fun minor(dev: Long): Long = (dev and 0xffL) or ((dev ushr 12) and 0xffffff00L)
+    private fun hex(bytes: ByteArray) = bytes.joinToString("") { "%02x".format(it.toInt() and 255) }
+    private fun readMaps(expected: List<Library>): Maps {
+        val raw = File("/proc/self/maps").inputStream().use { input ->
+            val out = java.io.ByteArrayOutputStream()
+            val buffer = ByteArray(64 * 1024)
+            while (true) { val n = input.read(buffer); if (n < 0) break; require(n > 0 && out.size() + n <= MAX_MAPS) { "proc maps bound" }; out.write(buffer, 0, n) }
+            out.toByteArray()
+        }
+        val found = mutableListOf<Segment>()
+        val regex = Regex("^([0-9a-fA-F]+)-([0-9a-fA-F]+)\\s+([r-][w-][x-][ps])\\s+([0-9a-fA-F]+)\\s+([0-9a-fA-F]+):([0-9a-fA-F]+)\\s+([0-9]+)(?:\\s+(.*))?$")
+        for (line in String(raw, Charsets.UTF_8).lineSequence().filter { it.isNotBlank() }) {
+            val match = requireNotNull(regex.matchEntire(line)) { "Malformed proc maps line" }
+            val mapped = match.groupValues[8]
+            if (!mapped.substringAfterLast('/').startsWith("librealityforge")) continue
+            require(mapped.startsWith('/') && !mapped.contains('\\') && !mapped.any { it.isWhitespace() }) { "Escaped/deleted/ambiguous native mapping" }
+            val library = requireNotNull(expected.singleOrNull { it.path.toString() == mapped }) { "Unexpected duplicate/fallback native mapping: $mapped" }
+            val segment = Segment(match.groupValues[1], match.groupValues[2], match.groupValues[3], match.groupValues[4],
+                match.groupValues[5].toLong(16), match.groupValues[6].toLong(16), match.groupValues[7].toLong(), mapped)
+            require(segment.inode == library.stamp.ino && segment.major == major(library.stamp.dev) && segment.minor == minor(library.stamp.dev)) { "Mapped device/inode differs from verified file" }
+            require(java.lang.Long.compareUnsigned(java.lang.Long.parseUnsignedLong(segment.start, 16), java.lang.Long.parseUnsignedLong(segment.end, 16)) < 0) { "Invalid mapping address range" }
+            found += segment
+        }
+        for (library in expected) {
+            val segments = found.filter { it.path == library.path.toString() }
+            require(segments.isNotEmpty() && segments.any { it.permissions[2] == 'x' }) { "Expected executable native mapping absent" }
+            require(segments.map { Triple(it.major, it.minor, it.inode) }.toSet().size == 1) { "Multiple mapped native file identities" }
+            val executableOffsets = segments.filter { it.permissions[2] == 'x' }.map { it.offset.toLong(16) }
+            require(executableOffsets.toSet().size == executableOffsets.size) { "Duplicate executable image mapping" }
+        }
+        return Maps(hex(MessageDigest.getInstance("SHA-256").digest(raw)), found)
+    }
+    private fun writeFresh(output: File, bytes: ByteArray, uid: Long) {
+        require(bytes.size in 1..MAX_OUTPUT) { "Native maps output bound" }
+        val path = canonical(output)
+        parent(path).use { dir ->
+            val attrs: PosixFileAttributes = requireNotNull(dir.getFileAttributeView(PosixFileAttributeView::class.java)).readAttributes()
+            val unix = Files.readAttributes(path.parent, "unix:uid,fileKey", NOFOLLOW)
+            require((unix.getValue("uid") as Number).toLong() == uid && unix["fileKey"].toString() == attrs.fileKey().toString() &&
+                attrs.permissions() == PosixFilePermissions.fromString("rwx------")) { "Output parent must be owned0700" }
+            val options: Set<OpenOption> = setOf(StandardOpenOption.WRITE, StandardOpenOption.CREATE_NEW, NOFOLLOW)
+            dir.newByteChannel(path.fileName, options, PosixFilePermissions.asFileAttribute(PosixFilePermissions.fromString("rw-------"))).use { channel ->
+                val buffer = ByteBuffer.wrap(bytes)
+                while (buffer.hasRemaining()) require(channel.write(buffer) > 0) { "Maps evidence write stalled" }
+            }
+            val before = stamp(path, dir, uid)
+            require(before.size == bytes.size.toLong()) { "Maps evidence size differs" }
+            val actual = dir.newByteChannel(path.fileName, setOf<OpenOption>(StandardOpenOption.READ, NOFOLLOW)).use { hash(it, before.size) }
+            val after = stamp(path, dir, uid)
+            require(before == after && actual == hex(MessageDigest.getInstance("SHA-256").digest(bytes))) { "Maps evidence verification failed" }
+        }
+    }
+    fun writeSnapshot(output: File, engine: File, shim: File): JSONObject {
+        require(System.getenv().keys.none { it.startsWith("LD_") }) { "Dynamic-loader environment overrides forbidden" }
+        val uid = effectiveUid()
+        val before = listOf(verify(engine, ENGINE, ENGINE_SHA, uid), verify(shim, SHIM, SHIM_SHA, uid))
+        require(before.map { it.stamp.dev to it.stamp.ino }.toSet().size == 2) { "Engine and JNI must be distinct files" }
+        val firstMaps = readMaps(before)
+        val intermediate = listOf(verify(engine, ENGINE, ENGINE_SHA, uid), verify(shim, SHIM, SHIM_SHA, uid))
+        require(before == intermediate) { "Mapped native file identities changed" }
+        val secondMaps = readMaps(intermediate)
+        val after = listOf(verify(engine, ENGINE, ENGINE_SHA, uid), verify(shim, SHIM, SHIM_SHA, uid))
+        require(before == after) { "Mapped native files changed after maps read" }
+        require(firstMaps.segments == secondMaps.segments) { "Native mappings changed during evidence read" }
+        val groups = JSONArray()
+        after.forEachIndexed { index, library ->
+            val segments = JSONArray()
+            secondMaps.segments.filter { it.path == library.path.toString() }.forEach { segments.put(it.json()) }
+            groups.put(JSONObject().put("role", if (index == 0) "engine" else "jni").put("path", library.path.toString())
+                .put("sha256", library.sha256).put("bytes", library.stamp.size).put("device", library.stamp.dev)
+                .put("deviceMajor", major(library.stamp.dev)).put("deviceMinor", minor(library.stamp.dev))
+                .put("inode", library.stamp.ino).put("uid", library.stamp.uid).put("linkCount", library.stamp.links).put("segments", segments))
+        }
+        val evidence = JSONObject().put("schema", 1).put("status", "VERIFIED_ACTUAL_JVM_NATIVE_MAPPINGS")
+            .put("source", "/proc/self/maps").put("jvmPid", currentJvmPid()).put("uid", uid)
+            .put("procMapsBeforeSha256", firstMaps.sha256).put("procMapsAfterSha256", secondMaps.sha256)
+            .put("relevantMappingsStable", true).put("nativeFilesPrePostStable", true).put("loaderEnvironmentOverrides", false)
+            .put("libraries", groups)
+            .put("scope", "Actual current host JVM mappings only; not Android-device or algorithm-quality evidence")
+        writeFresh(output, evidence.toString().toByteArray(Charsets.UTF_8), uid)
+        return evidence
+    }
