+package com.realityforge.scanner.hostintegration
+
+import com.realityforge.scanner.data.ScanPhoto
+import com.realityforge.scanner.data.ProjectRepository
+import com.realityforge.scanner.engine.DensePreview
+import com.realityforge.scanner.engine.NativeCore
+import com.realityforge.scanner.engine.artifacts.AlignmentCheckpointCodec
+import com.realityforge.scanner.engine.dense.DenseViewSelection
+import com.realityforge.scanner.engine.pipeline.*
+import com.realityforge.scanner.processing.resources.ResourceWorkloadSelection
+import kotlinx.coroutines.currentCoroutineContext
+import kotlinx.coroutines.ensureActive
+import org.json.JSONArray
+import org.json.JSONObject
+import java.io.File
+
+/** External diagnostic adapter; no fabricated native-window source IDs or observations. */
+internal object VerifiedProfilePair {
+    data class Inputs(val geometry: JSONObject, val selection: DenseViewSelection.Plan,
+        val support: Map<Int, Set<String>>, val threshold: Double, val proof: JSONObject)
+
+    fun inputs(restored: SparseAlignmentCache.Restored, photos: List<ScanPhoto>): Inputs {
+        val checkpoint = restored.checkpoint
+        val geometry = JSONObject(restored.geometry.toString())
+        MeasuredAlignmentCheckpoint.requireSameGeometry(geometry, checkpoint)
+        require(checkpoint.cameras.size == 3 && photos.size == 3)
+        val photoById = photos.associateBy { it.id }
+        require(photoById.size == 3 && checkpoint.cameras.map { it.photoId }.toSet() == photoById.keys)
+        val photoIds = checkpoint.cameras.map { it.photoId }
+        val pointIds = (0 until geometry.getJSONArray("points").length()).map {
+            geometry.getJSONArray("points").getJSONArray(it).getInt(8)
+        }.toSet()
+        require(pointIds.size == checkpoint.tracks.size)
+        val support = linkedMapOf<Int, Set<String>>()
+        val labels = linkedMapOf<Int, String>()
+        val byCamera = List(3) { linkedSetOf<String>() }
+        val relabels = JSONArray()
+        for (track in checkpoint.tracks) {
+            require(track.trackId.matches(Regex("track-[0-9]+")))
+            val id = track.trackId.removePrefix("track-").toInt()
+            require(id in pointIds && id !in support && track.trackId == "track-$id")
+            val cameraIndices = track.observations.map { it.cameraIndex }
+            require(cameraIndices.size >= 2 && cameraIndices.distinct().size == cameraIndices.size && cameraIndices.all { it in 0..2 })
+            val observed = cameraIndices.map { photoIds[it] }.toSet()
+            support[id] = observed
+            // This digest is ONLY a selector-compatible local label, not a claimed native source hash.
+            val label = sha256Utf8("host-checkpoint-track-label-v1|${checkpoint.acceptance.evidenceHash.hex}|${track.trackId}")
+            require(label !in labels.values); labels[id] = label
+            cameraIndices.forEach { byCamera[it].add(label) }
+            relabels.put(JSONObject().put("numericPointId", id).put("checkpointTrackId", track.trackId)
+                .put("localSelectorLabel", label).put("photoIds", JSONArray(observed.sorted())))
+        }
+        require(support.keys == pointIds)
+        val sharpness = photoIds.map { photoById.getValue(it).sharpness }
+        require(sharpness.all { it.isFinite() && it >= 0 })
+        val maximumSharpness = sharpness.maxOrNull() ?: error("No measured sharpness")
+        val cameras = checkpoint.cameras.mapIndexed { index, camera ->
+            require(camera.fx.isFinite() && camera.fy.isFinite() && camera.fx > 0 && camera.fy > 0)
+            // Reject the unreviewed refined-intrinsics case rather than substitute a focal threshold.
+            require(!geometry.getJSONArray("cameras").getJSONObject(index).has("refinedIntrinsics"))
+            val r = camera.rotationWorldToCamera; val t = camera.translationWorldToCamera
+            val centre = (0..2).map { axis -> -(0..2).sumOf { row -> r[row * 3 + axis] * t[row] } }
+            DenseViewSelection.Camera(camera.photoId, centre, byCamera[index],
+                if (maximumSharpness > 0) sharpness[index] / maximumSharpness else 0.0, true)
+        }
+        // Exact production selector defaults for source cap/minimum overlap; COMPACT reference ceiling.
+        val selection = DenseViewSelection.select(cameras, referenceCap = ResourceWorkloadSelection.COMPACT.maximumViews)
+        require(selection.referencePhotoIds.size == 3 && selection.exclusions.isEmpty())
+        require(selection.sourcePhotoIds.values.all { it.size == 2 })
+        val threshold = 3.0 / checkpoint.cameras.minOf { minOf(it.fx, it.fy) }
+        require(threshold.isFinite() && threshold > 0 && threshold <= .05)
+        val proof = JSONObject().put("schema",1).put("adapter", "validated-alignment-observations-to-selector-v1")
+            .put("scope", "local hashed track labels are not native-window source IDs; no projected/fabricated support")
+            .put("alignmentCheckpointSha256", java.security.MessageDigest.getInstance("SHA-256")
+                .digest(AlignmentCheckpointCodec.encode(checkpoint)).joinToString("") { "%02x".format(it.toInt() and 255) })
+            .put("trackRelabels", relabels).put("photoOrder", JSONArray(photoIds))
+            .put("measuredSharpness", JSONArray(sharpness)).put("sharpnessNormalizationMaximum", maximumSharpness)
+            .put("sparseThresholdNormalized", threshold).put("thresholdRule", "3/min(actual accepted frame fx,fy); reject refined intrinsics")
+            .put("referencePhotoIds", JSONArray(selection.referencePhotoIds))
+            .put("sourcePhotoIds", JSONObject(selection.sourcePhotoIds))
+        return Inputs(geometry, selection, support.mapValues { it.value.toSet() }, threshold, proof)
+    }
+
+    suspend fun run(repository: ProjectRepository, projectId: String, photos: List<ScanPhoto>,
+        snapshot: PipelineInputSnapshot, focal: Double, input: Inputs,
+        tokens: List<Long>): List<JSONObject> {
+        require(tokens.size == 2 && tokens.distinct().size == 2 && tokens.all { it > 0 })
+        val outcomes = arrayListOf<JSONObject>()
+        for ((profileIndex, profile) in listOf(DensePreviewProfile.Compatibility, DensePreviewProfile.VerifiedRefinedCompact).withIndex()) {
+            currentCoroutineContext().ensureActive()
+            val settings = snapshot.settings.copy(
+                dense = snapshot.settings.dense + "|host-profile=" + profile.name + "|" + DenseExecutionPolicy.depth(profile),
+                texture = snapshot.settings.texture + "|host-profile=" + profile.name + "|" + DenseExecutionPolicy.texture(profile))
+            val selectedSnapshot = snapshot.copy(settings = settings)
+            require(selectedSnapshot.identity(PipelineStage.SPARSE) == snapshot.identity(PipelineStage.SPARSE))
+            require(selectedSnapshot.identity(PipelineStage.DENSE) != snapshot.identity(PipelineStage.DENSE))
+            val key = "sparse-m16-r${snapshot.revision}-${sha256Utf8("host-profile-pair|${selectedSnapshot.identity(PipelineStage.DENSE).digest}").take(16)}"
+            require(!File(repository.directory(projectId), "$key.mesh.ply").exists())
+            val token = tokens[profileIndex]
+            val payload = run {
+                DensePreview.reconstructTyped(repository, projectId, key, photos,
+                    JSONArray(input.geometry.getJSONArray("cameras").toString()),
+                    JSONArray(input.geometry.getJSONArray("points").toString()), focal, null, token,
+                    selectedSnapshot, resourceSelection = ResourceWorkloadSelection.COMPACT,
+                    surfaceCheckpoint = null, selection = input.selection, executionProfile = profile,
+                    acceptedSparseSupport = input.support, sparseThresholdNormalized = input.threshold).payload
+            } // Both real tokens remain parent-owned until the entire worker has stopped.
+            // Diagnostic only: preserve actual return in JUnit XML even if quality gates reject it.
+            val diagnostic = JSONObject().put("profile",profile.name).put("artifactKey",key)
+                .put("scope","actual direct API return; not quality PASS").put("payload",payload).toString()
+            require(diagnostic.toByteArray(Charsets.UTF_8).size in 1..(4*1024*1024))
+            println("PROFILE_DIAGNOSTIC $diagnostic")
+            val dense = payload.getJSONObject("dense")
+            require(dense.getString("executionProfile") == profile.name && !dense.getBoolean("geometryReused"))
+            require(dense.getInt("rectifiedWidth") == 256 && dense.getInt("rectifiedHeight") == 192)
+            require(dense.getInt("pixelStride") == 3 && dense.getInt("depthPlanes") == 56)
+            require(dense.getJSONObject("workload").getString("memoryTier") == "compact")
+            require(dense.getJSONArray("selectedPhotoIds").toString() == JSONArray(input.selection.referencePhotoIds).toString())
+            require(dense.getInt("depthCheckpointResumed") == 0)
+            require(payload.has("mesh")) { "${profile.name}: mesh rejected: ${payload.optString("meshError")}; see actual diagnostic payload" }
+            require(payload.has("texture")) { "${profile.name}: texture rejected: ${payload.optString("textureError")}; see actual diagnostic payload" }
+            if (profile == DensePreviewProfile.Compatibility) require(dense.getBoolean("surfaceCheckpointAvailable"))
+            else require(!dense.getBoolean("surfaceCheckpointAvailable") && !dense.getBoolean("surfaceCheckpointWritten") && dense.getInt("depthCheckpointWritten") == 0) {
+                "Refined checkpoint policy differs from original uncached refinement contract"
+            }
+            outcomes.add(JSONObject().put("profile",profile.name).put("artifactKey",key)
+                .put("denseStageIdentity",selectedSnapshot.identity(PipelineStage.DENSE).digest)
+                .put("textureStageIdentity",selectedSnapshot.identity(PipelineStage.TEXTURE).digest)
+                .put("denseSettings",settings.dense).put("textureSettings",settings.texture).put("payload",payload))
+        }
+        require(outcomes[0].getJSONObject("payload").getJSONObject("dense").getJSONArray("executedSourcePhotoIds").toString() ==
+            outcomes[1].getJSONObject("payload").getJSONObject("dense").getJSONArray("executedSourcePhotoIds").toString()) {
+            "Actual source adjacency differs; cannot claim a same-selection profile comparison"
+        }
+        require(outcomes.map { it.getString("artifactKey") }.distinct().size == 2)
+        require(outcomes.map { it.getJSONObject("payload").getJSONObject("dense").getString("depthCheckpointIdentity") }.distinct().size == 2)
+        return outcomes
+    }
+}
